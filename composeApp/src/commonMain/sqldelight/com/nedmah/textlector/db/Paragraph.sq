CREATE TABLE paragraph (
    id TEXT NOT NULL PRIMARY KEY,
    document_id TEXT NOT NULL,
    index_in_doc INTEGER NOT NULL,
    text TEXT NOT NULL,
    tts_text TEXT,
    FOREIGN KEY (document_id) REFERENCES document(id) ON DELETE CASCADE
);

CREATE INDEX idx_paragraph_document_id ON paragraph(document_id);

selectByDocumentId:
SELECT * FROM paragraph
WHERE document_id = :documentId
ORDER BY index_in_doc ASC;

selectByDocumentIdAndIndex:
SELECT * FROM paragraph
WHERE document_id = :documentId
  AND index_in_doc = :indexInDoc
LIMIT 1;

selectIndicesByDocumentId:
SELECT index_in_doc FROM paragraph
WHERE document_id = :documentId
ORDER BY index_in_doc ASC;

selectPreparedIndicesByDocumentId:
SELECT index_in_doc FROM paragraph
WHERE document_id = :documentId
  AND tts_text IS NOT NULL
ORDER BY index_in_doc ASC;

insertParagraph:
INSERT INTO paragraph(id, document_id, index_in_doc, text, tts_text)
VALUES (?, ?, ?, ?, ?);

updateTtsText:
UPDATE paragraph
SET tts_text = :ttsText
WHERE id = :paragraphId;

deleteByDocumentId:
DELETE FROM paragraph
WHERE document_id = :documentId;